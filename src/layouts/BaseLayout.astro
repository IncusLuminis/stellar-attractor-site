---
// Application shell wrapper (Technical Architecture §5).
// Stays deliberately thin for the Phase 1 skeleton — real HUD layer, locale
// provider and navigation controller land in later phases.
//
// HUD token layer (#24). hud.css @imports the shared design-token re-export
// (src/styles/tokens.css -> shared/style/stellar-attractor.css, no fork —
// Implementation Plan §1 decision 8) and layers stable `--hud-*` role names
// plus a `:root` reduced-motion scaffold on top. CSS custom properties + a few
// token hooks only: no rules of consequence, no JavaScript, no components
// (those are #25/#26). Importing hud.css here also pulls in tokens.css.
import "../hud/hud.css";

// i18n hooks (#20). Kept minimal + additive so #19 (routing) can merge its own
// changes to this file cleanly. Three additions, all below:
//   1. `hreflang` alternates in <head>, from `buildHreflangAlternates(Astro.url)`
//   2. a module <script> importing `../core/i18n/boot` (resolves ?lang= > stored
//      > `en` on the client and swaps `[data-i18n]` text after hydration)
//   3. `<html lang>` already existed — the boot script updates it client-side.
// Pages prerender the DEFAULT locale (`en`); see src/core/i18n/README.md.
//
// #19 addition (routing): a per-route <link rel="canonical"> pointing at the
// clean URL (no `?lang=`). Entity pages are directly addressable and must not
// be treated as duplicates of `/` or of their own `?lang=ru` variant
// (Technical Architecture §40). The clean URL is exactly the `en` hreflang
// alternate, so it is reused rather than recomputed.
import { DEFAULT_LOCALE, type Locale } from "../core/i18n/types";
import { buildHreflangAlternates } from "../core/i18n/hreflang";

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
}

const {
  title,
  description = "Stellar Attractor — an interactive universe.",
  lang = DEFAULT_LOCALE,
} = Astro.props;

const hreflangAlternates = buildHreflangAlternates(Astro.url);
const canonicalHref =
  hreflangAlternates.find((alt) => alt.hreflang === "en")?.href ?? Astro.url.toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {
      hreflangAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <link rel="canonical" href={canonicalHref} />
    <title>{title}</title>
    <script>
      import "../core/i18n/boot";
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100dvh;
    background: var(--sa-colors-bg, #02070d);
    color: var(--sa-colors-text-main, #d8fbff);
    font-family: var(--sa-font-mono, Menlo, Consolas, "Roboto Mono", monospace);
  }
</style>
