{
  "$id": "localized-text.schema.json",
  "title": "LocalizedText",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ru": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "en": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "ru",
    "en"
  ],
  "additionalProperties": false
}
