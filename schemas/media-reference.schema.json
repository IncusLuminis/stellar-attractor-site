{
  "$id": "media-reference.schema.json",
  "title": "MediaReference",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "portrait",
        "hero",
        "gallery",
        "diagram",
        "living-preview",
        "thumbnail"
      ]
    },
    "alt": {
      "type": "object",
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ru",
        "en"
      ],
      "additionalProperties": false
    },
    "caption": {
      "type": "object",
      "properties": {
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ru",
        "en"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false
}
